# Copy this file to .env and fill in your values. Never commit .env.

# Mist API token: Org Settings > API Tokens (org token) or your user profile (personal token)
MIST_API_TOKEN=

# Mist cloud region base URL - pick the one matching your org:
#   US:      https://api.mist.com
#   EU:      https://api.eu.mist.com
#   APAC:    https://api.ac2.mist.com
#   GovCloud https://api.gc1.mist.com
MIST_BASE_URL=https://api.mist.com

# Filled in after running scripts/discover.py once you know them
MIST_ORG_ID=
MIST_SITE_ID=
